@model TSmartClinic.Presentation.Models.ConvenioViewModel

@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewBag.Titulo = "Cadastro de Convênio";
}

<form asp-controller="Convenios" asp-action="Cadastro" method="post">
    <input asp-for="PublicId" type="hidden" />

    <div class="row">
        <div class="col-md-12">
            <div class="card card-small">

                <div class="card-body">

                    @* ========================= DADOS DO CONVÊNIO ========================= *@

                    <div class="form-secao-titulo">
                        <i class="fa-solid fa-handshake"></i> Dados do Convênio
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label-tsmart">Nome do Convênio</label>
                            <div class="campo-com-icone">
                                <i class="fa-solid fa-handshake"></i>
                                @Html.TextBoxFor(model => model.NomeConvenio, new { @class = "form-control", @autocomplete = "off", @placeholder = "Nome do convênio" })
                            </div>
                            <span class="text-danger">@Html.ValidationMessageFor(model => model.NomeConvenio)</span>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label-tsmart">CNPJ</label>
                            <div class="campo-com-icone">
                                <i class="fa-regular fa-id-card"></i>
                                @Html.TextBoxFor(model => model.CNPJ, new { @class = "form-control", @autocomplete = "off", @placeholder = "00.000.000/0000-00" })
                            </div>
                            <span class="text-danger">@Html.ValidationMessageFor(model => model.CNPJ)</span>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label-tsmart">Telefone</label>
                            <div class="campo-com-icone">
                                <i class="fa-solid fa-phone"></i>
                                @Html.TextBoxFor(model => model.Telefone, new { @class = "form-control", @autocomplete = "off", @placeholder = "(00) 00000-0000" })
                            </div>
                            <span class="text-danger">@Html.ValidationMessageFor(model => model.Telefone)</span>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label class="form-label-tsmart">Email</label>
                            <div class="campo-com-icone">
                                <i class="fa-regular fa-envelope"></i>
                                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @autocomplete = "off", @type = "email", @placeholder = "email@convenio.com.br" })
                            </div>
                            <span class="text-danger">@Html.ValidationMessageFor(model => model.Email)</span>
                        </div>
                    </div>

                    @if (ViewBag.UsuarioMaster == true)
                    {
                        <div class="col-md-4">
                            <label class="form-label-tsmart">Cliente</label>
                            <div class="campo-com-icone">
                                <i class="fa-solid fa-building"></i>
                                <select asp-for="ClienteId"
                                        asp-items="ViewBag.Clientes"
                                        class="form-select">
                                </select>
                            </div>
                            <span class="text-danger">
                                @Html.ValidationMessageFor(model => model.ClienteId)
                            </span>
                        </div>
                    }

                </div>

                @* ========================= SITUAÇÃO / AÇÕES ========================= *@

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-2">
                            <label class="form-label-tsmart">Situação</label>

                            @if (!Model.PublicId.HasValue || Model.PublicId.Value == Guid.Empty)
                            {
                                <input type="hidden" asp-for="Ativo" value="true" />
                                <div class="campo-com-icone">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <select class="form-select" disabled>
                                        <option selected>Ativo</option>
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="campo-com-icone">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <select asp-for="Ativo" class="form-select">
                                        <option value="true">Ativo</option>
                                        <option value="false">Inativo</option>
                                    </select>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success"
                                asp-permissao="@(Model.PublicId.HasValue && Model.PublicId.Value != Guid.Empty ? "Convenios_Editar" : "Convenios_Incluir")"
                                onclick="loading()">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Gravar
                        </button>

                        @if (Model.PublicId.HasValue && Model.PublicId.Value != Guid.Empty)
                        {
                            <button type="submit" class="btn btn-danger" asp-permissao="Convenios_Excluir"
                                    formaction="@Url.Action("Excluir", "Convenios")" formmethod="post" onclick="loading()">
                                <i class="fa-regular fa-trash-can me-1"></i> Excluir
                            </button>
                        }

                        <a href="/Convenios/Consulta" class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i> Voltar
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</form>