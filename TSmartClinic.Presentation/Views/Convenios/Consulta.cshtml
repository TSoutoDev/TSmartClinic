@using TSmartClinic.Presentation.Models
@model TSmartClinic.Presentation.Models.ResponseViewModel<ConvenioViewModel>

@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewBag.Titulo = "Consulta de Convênios";
}

<!-- ========================= -->
<!-- FILTROS                   -->
<!-- ========================= -->
<div class="card">
    <div class="card-body">

        <ul class="nav nav-tabs" role="tablist" id="tabBusca">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#busca_padrao" role="tab">
                    <span class="d-block d-sm-none"><i class="fas fa-search"></i></span>
                    <span class="d-none d-sm-block">Busca padrão</span>
                </a>
            </li>
        </ul>

        <div class="tab-content pt-3 text-muted">

            <div class="tab-pane active" id="busca_padrao" role="tabpanel">

                <form asp-controller="Convenios" asp-action="BuscaPadrao" method="post">

                    <div class="row">

                        <div class="col-md-5">
                            <input type="text"
                                   name="nome"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="Digite o nome do convênio"
                                   value="@(ViewBag.Filtro?.Nome ?? "")" />
                        </div>

                        <div class="col-md-2">
                            <select class="form-select" name="ativo">
                                <!option value="true">Ativo</!option>

                                <!option value="false"
                                @(ViewBag.Filtro != null && !ViewBag.Filtro.Ativo ? "selected" : "")>
                                Inativo
                                </!option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button type="submit"
                                    asp-permissao="Convenios_Acessar"
                                    class="btn btn-success"
                                    onclick="loading()"
                                    style="height:38px;">
                                <i class="fa fa-search"></i>&nbsp;Pesquisar
                            </button>
                        </div>

                        <div class="col-md-3 text-end">
                            <a asp-controller="Convenios"
                               asp-action="Cadastro"
                               asp-permissao="Convenios_Incluir"
                               class="btn btn-primary"
                               onclick="loading()"
                               style="height:38px;">
                                <i class="fa fa-plus"></i>&nbsp;Novo Convênio
                            </a>
                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>


<!-- ========================= -->
<!-- RESULTADOS                -->
<!-- ========================= -->
@if (Model?.Itens != null && Model.Itens.Count > 0)
{
    <div class="card">
        <div class="card-body">

            <table id="gridResultados" class="table table-hover table-striped">

                <thead class="table-header">
                    <tr>
                        <th>Convênio</th>
                        <th>CNPJ</th>
                        <th>Telefone</th>
                        <th>Email</th>
                        <th>Situação</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Itens)
                    {
                        <tr class="clickable"
                            style="cursor:pointer;"
                            onclick="location.href='@Url.Action("Cadastro", "Convenios", new { publicId = item.PublicId })'">

                            <td>@item.NomeConvenio?.ToUpper()</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CNPJ) ? "-" : item.CNPJ)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Telefone) ? "-" : item.Telefone)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)</td>
                            <td>@(item.Ativo == true ? "ATIVO" : "INATIVO")</td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
}
else if (Model != null)
{
    <div class="alert alert-info">
        <i class="fa fa-info-circle"></i>&nbsp;Nenhum convênio encontrado.
    </div>
}


@section Scripts
{
    <script>
        $(document).ready(function () {

            if ($('#gridResultados').length && typeof $.fn.DataTable !== 'undefined') {
                $('#gridResultados').DataTable(dataTableLocalInit());
            }

        });
    </script>
}