@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Antiforgery
@using System.Linq
@using TSmartClinic.Presentation.Services.Interfaces
@using TSmartClinic.Presentation.Models

@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject IUsuarioLogadoService _usuarioLogadoService

@{
    var nome = HttpContextAccessor.HttpContext?.Session.GetString("Usuario_Nome") ?? "Usuário";
    var nomeCliente = HttpContextAccessor.HttpContext?.Session.GetString("Cliente_Nome") ?? "TSmartClinic";
    var nomeUnidade = HttpContextAccessor.HttpContext?.Session.GetString("Unidade_Nome") ?? nomeCliente;
    var unidadeId = HttpContextAccessor.HttpContext?.Session.GetString("Unidade_Id");
    var usuarioId = HttpContextAccessor.HttpContext?.Session.GetString("Usuario_Id");
    var clienteId = HttpContextAccessor.HttpContext?.Session.GetString("Cliente_Id") ?? "";
    var unidadesJson = HttpContextAccessor.HttpContext?.Session.GetString("Unidades");
    var unidades = new List<UnidadeLoginViewModel>();

    if (!string.IsNullOrWhiteSpace(unidadesJson))
    {
        unidades = System.Text.Json.JsonSerializer.Deserialize<List<UnidadeLoginViewModel>>(unidadesJson)
            ?? new List<UnidadeLoginViewModel>();
    }

    var usuarioMaster = _usuarioLogadoService.UsuarioMaster;

    var iniciais = string.Join("", nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var titulo = ViewBag.Titulo as string ?? "Início";
}

<!doctype html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="TSmartClinic - Gestão inteligente para clínicas." />
    <meta name="theme-color" content="#0b1f4b" />

    <title>@titulo - TSmartClinic</title>

    <link rel="shortcut icon" href="~/assets/images/favicon.ico" />
    <link href="~/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/assets/css/app.min.css" id="app-style" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/card-estilo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/DadosPacientes-estilo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/busca-rapida-paciente.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tsmartclinic-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)
</head>

<body data-sidebar="dark" data-keep-enlarged="true" class="tsmart-app">

    @Html.AntiForgeryToken()
    @Html.AntiForgeryToken()
    <input id="IdEmpresaAtiva" type="hidden" />
    <input type="hidden" id="ClienteIdAtivo" value="@clienteId" />

    <script id="UnidadesUsuario" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(unidades))
    </script>

    <div id="layout-wrapper">

        <!-- TOPBAR -->
        <header id="page-topbar" class="tsmart-topbar">
            <div class="navbar-header tsmart-navbar-header">

                <div class="navbar-brand-box tsmart-brand-box">
                    <a href="/Home/Index" class="logo logo-light" aria-label="Ir para o início">
                        <span class="logo-sm"><img src="~/images/branding/tsmartclinic-symbol.svg" alt="TSmartClinic" /></span>
                        <span class="logo-lg"><img src="~/images/branding/tsmartclinic-logo-on-dark.svg" alt="TSmartClinic" /></span>
                    </a>
                </div>

                <button type="button" class="btn tsmart-menu-toggle" id="vertical-menu-btn" aria-label="Expandir ou recolher menu" aria-expanded="false"><i class="bx bx-menu-alt-left"></i></button>

                <div class="tsmart-search-area">
                    <div class="quick-patient-search" id="quickPatientSearch">
                        <div class="input-group input-group-sm quick-patient-input">
                            <span class="input-group-text"><span class="qp-avatar" aria-hidden="true"><i class="bx bx-user"></i></span></span>
                            <input id="pacienteSearch" class="form-control" type="text" placeholder="Buscar paciente por nome, CPF ou código..." autocomplete="off" aria-label="Buscar paciente" />
                        </div>

                        <div id="pacienteSugestoes" class="dropdown-menu quick-patient-dropdown shadow-lg" style="display:none;"></div>
                    </div>
                </div>

                <div class="tsmart-user-area">
                    <div class="dropdown d-none d-md-flex">
                        <button type="button"
                                class="btn tsmart-clinic-context"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span class="context-label">Unidade ativa</span>
                            <span class="context-name" title="@nomeUnidade">
                                @nomeUnidade
                                <i class="mdi mdi-chevron-down ms-1"></i>
                            </span>
                        </button>

                        <div class="dropdown-menu dropdown-menu-end">
                            @foreach (var unidade in unidades)
                            {
                                var unidadeAtiva = unidade.Id.ToString() == unidadeId;

                                <form asp-controller="Account" asp-action="TrocarUnidade" method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="unidadeId" value="@unidade.Id" />

                                    <button type="submit"
                                            class="dropdown-item @(unidadeAtiva ? "active" : "")"
                                            @(unidadeAtiva ? "disabled" : "")>
                                        <i class="bx bx-building-house me-2"></i>
                                        @unidade.NomeUnidade

                                        @if (unidadeAtiva)
                                        {
                                            <span class="ms-2">✓</span>
                                        }
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="dropdown">
                        <button type="button" class="btn header-item tsmart-user-button" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="tsmart-avatar">@iniciais</span>
                            <span class="tsmart-user-name d-none d-xl-inline-block">@nome</span>
                            <i class="mdi mdi-chevron-down d-none d-xl-inline-block"></i>
                        </button>

                        <div class="dropdown-menu dropdown-menu-end tsmart-user-menu">
                            <a class="dropdown-item" href="#" id="btnMinhaConta"><i class="bx bx-user font-size-16 align-middle me-2"></i>Minha Conta</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-danger" href="/Account/Logout"><i class="bx bx-power-off font-size-16 align-middle me-2"></i>Sair do Sistema</a>
                        </div>
                    </div>
                </div>

            </div>
        </header>

        <!-- MENU LATERAL -->
        <aside class="vertical-menu tsmart-sidebar">
            <div data-simplebar class="h-100">
                <div id="sidebar-menu">
                    <ul class="metismenu list-unstyled" id="side-menu">

                        <li class="menu-title" key="t-menu">Menu Principal</li>

                        <!-- ========================= -->
                        <!-- PACIENTES                 -->
                        <!-- HABILITADO                -->
                        <!-- ========================= -->
                        <li>
                            <a href="/Pacientes/Consulta"
                               key="t-blog"
                               asp-permissao="Pacientes_Acessar">
                                <i class="bx bx-user"></i>
                                <span>Pacientes</span>
                            </a>
                        </li>


                        <!-- ========================= -->
                        <!-- CLÍNICAS                  -->
                        <!-- HABILITADO                -->
                        <!-- ========================= -->
                        <li>
                            <a href="/Clientes/Consulta"
                               key="t-blog"
                               asp-permissao="Clientes_Acessar">
                                <i class="bx bx-building-house"></i>
                                <span key="t-layouts">Clínicas</span>
                            </a>
                        </li>


                        <!-- ========================= -->
                        <!-- ATENDIMENTOS              -->
                        <!-- TEMPORARIAMENTE BLOQUEADO -->
                        <!-- ========================= -->
                        <li>
                            <a href="javascript:void(0);"
                               class="menu-disabled"
                               aria-disabled="true">
                                <i class="bx bx-calendar"></i>
                                <span key="t-layouts">Atendimentos</span>
                            </a>
                        </li>


                        <!-- ========================= -->
                        <!-- FATURAMENTO               -->
                        <!-- TEMPORARIAMENTE BLOQUEADO -->
                        <!-- ========================= -->
                        <li>
                            <a href="javascript:void(0);"
                               class="menu-disabled"
                               aria-disabled="true">
                                <i class="bx bx-money"></i>
                                <span key="t-layouts">Faturamento</span>
                            </a>
                        </li>


                        <!-- ========================= -->
                        <!-- RELATÓRIOS                -->
                        <!-- TEMPORARIAMENTE BLOQUEADO -->
                        <!-- ========================= -->
                        <li>
                            <a href="javascript:void(0);"
                               class="menu-disabled"
                               aria-disabled="true">
                                <i class="bx bx-archive-out"></i>
                                <span key="t-dashboards">Relatórios</span>
                            </a>
                        </li>


                        <!-- ========================= -->
                        <!-- CADASTROS                 -->
                        <!-- NÍVEL 1                   -->
                        <!-- ========================= -->
                        <li>
                            <a href="javascript:void(0);"
                               class="has-arrow waves-effect">
                                <i class="bx bx-layout"></i>
                                <span key="t-layouts">Cadastros</span>
                            </a>

                            <ul class="sub-menu" aria-expanded="false">

                                <!-- ========================= -->
                                <!-- NICHOS                    -->
                                <!-- NÍVEL 2 / HABILITADO      -->
                                <!-- ========================= -->
                                @if (usuarioMaster)
                                {
                                    <a href="/Nichos">
                                        <i class="bx bx-category"></i>
                                        <i class="bx bx-crown ms-1 text-warning" title="Exclusivo para Master"></i>
                                        <span>Nichos</span>
                                        
                                    </a>
                                }


                                <!-- ========================= -->
                                <!-- CONVÊNIOS                 -->
                                <!-- NÍVEL 2 / HABILITADO      -->
                                <!-- ========================= -->
                                <li>
                                    <a href="/Convenios/Consulta"
                                       asp-permissao="Convenios_Acessar">
                                        <i class="bx bx-list-ul"></i>
                                        <span>Convênios</span>
                                    </a>
                                </li>

                            </ul>
                        </li>


                        <!-- ========================= -->
                        <!-- CENTRAL DE NOTIFICAÇÕES   -->
                        <!-- TEMPORARIAMENTE BLOQUEADO -->
                        <!-- ========================= -->
                        <li>
                            <a href="javascript:void(0);"
                               class="menu-disabled"
                               aria-disabled="true">
                                <i class="bx bx-bell"></i>
                                <span key="t-dashboards">Central de Notificações</span>
                            </a>
                        </li>


                        <!-- ========================= -->
                        <!-- SUPORTE                   -->
                        <!-- TEMPORARIAMENTE BLOQUEADO -->
                        <!-- ========================= -->
                        <li>
                            <a href="javascript:void(0);"
                               class="menu-disabled"
                               aria-disabled="true">
                                <i class="bx bx-support"></i>
                                <span key="t-dashboards">Suporte</span>
                            </a>
                        </li>


                        <!-- ========================= -->
                        <!-- CONFIGURAÇÕES             -->
                        <!-- HABILITADO                -->
                        <!-- ========================= -->
                        <li>
                            <a href="/Configuracoes/Configuracoes"
                               class="waves-effect">
                                <i class="bx bx-cog"></i>
                                <span key="t-layouts">Configurações</span>
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </aside>

        <!-- CONTEÚDO -->
        <main class="main-content tsmart-main">
            <div class="page-content tsmart-page-content">
                <div class="container-fluid">

                    <div class="tsmart-page-heading">
                        <div>
                            <span class="tsmart-page-kicker">TSmartClinic</span>
                            <h1 class="tsmart-page-title">@titulo</h1>
                        </div>

                        <a href="/Home/Index" class="tsmart-home-link" title="Página inicial"><i class="bx bx-home-alt"></i></a>
                    </div>

                    @if (TempData["MensagemSucesso"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>@TempData["MensagemSucesso"]</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                        </div>
                    }
                    else if (TempData["MensagemErro"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>@TempData["MensagemErro"]</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                        </div>
                    }
                    else if (TempData["MensagemAlerta"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <strong>@TempData["MensagemAlerta"]</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                        </div>
                    }

                    @{
                        string paginador = "CLIENTE";
                        if (ViewBag?.Paginador != null) { paginador = ViewBag.Paginador; }
                    }

                    <input type="hidden" id="Paginador" value="@paginador" />

                    @RenderBody()

                </div>
            </div>

            <footer class="footer tsmart-footer">
                <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span><script>document.write(new Date().getFullYear())</script> © TSmartClinic</span>
                    <span>Versão 1.0</span>
                </div>
            </footer>
        </main>

    </div>

    <!-- MINHA CONTA -->
    <div class="modal fade" id="minhaContaModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="minhaContaContent"></div>
        </div>
    </div>

    <!-- MANTIDO PARA NÃO ALTERAR O FLUXO ATUAL -->
    <div id="modalTrocarEmpresa" class="modal fade modal-trocar-empresa" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Seleção de Empresa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    <span id="mensagemSemEmpresaAtiva">Você não possui nenhuma empresa ativa, favor selecione.</span>
                    <input id="autocompleteempresamodal" class="form-control" autocomplete="on" placeholder="Informe parte do nome da empresa" />
                    <div id="sugestaoEmpresasModal" class="autocomplete-empresas"></div>
                </div>

            </div>
        </div>
    </div>


    <!-- CONFIRMAÇÃO DE TROCA DE UNIDADE -->
    <div class="modal fade" id="modalConfirmarTrocaUnidade" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tsmart-confirm-modal">

                <div class="modal-body text-center p-4">

                    <div class="tsmart-confirm-icon mb-3">
                        <i class="bx bx-building-house"></i>
                    </div>

                    <h5 class="mb-2">Alterar unidade?</h5>

                    <p class="text-muted mb-3">
                        Este paciente pertence a outra unidade.
                    </p>

                    <div class="tsmart-confirm-info">
                        <strong id="trocaPacienteNome"></strong>
                        <span id="trocaClinicaNome"></span>
                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="button" class="btn btn-primary" id="btnConfirmarTrocaUnidade">
                            Mudar e acessar
                        </button>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <!-- SCRIPTS -->
    <environment include="Development">
        <script src="~/_framework/aspnetcore-browser-refresh.js"></script>


    </environment>

    <!-- BIBLIOTECAS PRINCIPAIS -->
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>

    <!-- DATATABLES -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js"></script>
    <script src="~/assets/js/pages/datatables.init.js"></script>
    <script src="~/js/pages/datatables.init.js"></script>
    <script src="~/js/datatable-custom.js" asp-append-version="true"></script>

    <!-- BIBLIOTECAS EXTERNAS -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>

    <!-- SCRIPTS DA APLICAÇÃO -->
    <script src="~/assets/js/app.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/validacoes.js" asp-append-version="true"></script>
    <script src="~/js/data-table-base.js" asp-append-version="true"></script>
    <script src="~/js/endereco.js" asp-append-version="true"></script>
    <script src="~/js/mascaras.js" asp-append-version="true"></script>
    <script src="~/js/busca-paciente-header.js" asp-append-version="true"></script>

    <script>
        $(function () {
            $('#vertical-menu-btn').on('click', function () {
                window.setTimeout(function () {
                    var collapsed = $('body').hasClass('vertical-collpsed');
                    $('#vertical-menu-btn').attr('aria-expanded', (!collapsed).toString());
                }, 0);
            });

            const currentPath = (window.location.pathname || '/').replace(/\/$/, '').toLowerCase() || '/';

            $('#side-menu a[href]').each(function () {
                const rawHref = ($(this).attr('href') || '').trim();

                if (!rawHref || rawHref === '#' || rawHref.toLowerCase().startsWith('javascript:')) return;

                let linkPath;

                try {
                    linkPath = new URL(rawHref, window.location.origin).pathname.replace(/\/$/, '').toLowerCase() || '/';
                }
                catch {
                    return;
                }

                const isActive = currentPath === linkPath || (linkPath !== '/' && currentPath.startsWith(linkPath + '/'));

                if (!isActive) return;

                $(this).addClass('active').attr('aria-current', 'page');
                $(this).parents('ul.sub-menu').addClass('mm-show').attr('aria-expanded', 'true');
                $(this).parents('li').addClass('mm-active');
                $(this).parents('li').children('a.has-arrow').attr('aria-expanded', 'true');
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        const btnMinhaConta = document.getElementById("btnMinhaConta");
        const modalEl = document.getElementById("minhaContaModal");

        if (!btnMinhaConta || !modalEl)
            return;

        const modal = new bootstrap.Modal(modalEl);

        btnMinhaConta.addEventListener("click", function (e) {

            e.preventDefault();

            fetch('/MinhaConta/DetalhesMinhaConta')
                .then(response => {

                    if (!response.ok)
                        throw new Error("Erro ao carregar Minha Conta");

                    return response.text();
                })
                .then(html => {

                    document.getElementById("minhaContaContent").innerHTML = html;

                    modal.show();
                })
                .catch(error => {
                    console.error("Erro ao carregar Minha Conta:", error);
                });
            });
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>