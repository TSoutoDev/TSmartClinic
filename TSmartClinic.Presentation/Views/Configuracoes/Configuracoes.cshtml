@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewBag.Titulo = "Configurações";
}

@section Styles
{
    <style>
        .config-section {
            margin-bottom: 28px;
        }

        .config-section-header {
            margin-bottom: 18px;
        }

        .config-section-title {
            font-size: 18px;
            font-weight: 600;
            color: #24324a;
            margin-bottom: 4px;
        }

        .config-section-description {
            font-size: 13px;
            color: #8490a3;
            margin: 0;
        }

        .config-card {
            height: 100%;
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 12px;
            transition: all .2s ease;
            position: relative;
        }

            .config-card:hover {
                transform: translateY(-2px);
                border-color: #d7e0ec;
                box-shadow: 0 8px 22px rgba(29, 48, 78, .07);
            }

        .config-card-link {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 20px;
            color: inherit;
            text-decoration: none;
            height: 100%;
        }

            .config-card-link:hover {
                color: inherit;
                text-decoration: none;
            }

        .config-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3f6fb;
            color: #315da8;
            font-size: 21px;
        }

        .config-card-content {
            flex: 1;
            min-width: 0;
        }

        .config-card-title {
            font-size: 15px;
            font-weight: 600;
            color: #25344d;
            margin-bottom: 4px;
        }

        .config-card-description {
            font-size: 12.5px;
            color: #7f8b9d;
            line-height: 1.45;
            margin: 0;
        }

        .config-card-arrow {
            color: #a4afbf;
            font-size: 15px;
        }

        .config-card:hover .config-card-arrow {
            color: #315da8;
        }

        .config-card-disabled {
            opacity: .55;
            pointer-events: none;
            background: #fafbfc;
        }

        .config-badge {
            position: absolute;
            top: 8px;
            right: 10px;
            font-size: 10px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 20px;
            background: #fff1f1;
            color: #c95858;
        }
    </style>
}


<div class="config-section">

    <div class="config-section-header">
        <div class="config-section-title">
            Administração do sistema
        </div>

        <p class="config-section-description">
            Gerencie usuários, perfis, clínicas e configurações de acesso.
        </p>
    </div>


    <div class="row g-3">

        <!-- USUÁRIOS -->
        <div class="col-xl-4 col-md-6" asp-permissao="Usuarios_Acessar">
            <div class="config-card">

                <a href="@Url.Action("Consulta", "Usuarios")" class="config-card-link">

                    <div class="config-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <div class="config-card-content">
                        <div class="config-card-title">Usuários</div>
                        <p class="config-card-description">
                            Gerencie usuários e seus acessos ao sistema.
                        </p>
                    </div>

                    <div class="config-card-arrow">
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>

                </a>

            </div>
        </div>


        <!-- PERFIS -->
        <div class="col-xl-4 col-md-6" asp-permissao="Perfis_Acessar">
            <div class="config-card">

                <a href="@Url.Action("Consulta", "Perfis")" class="config-card-link">

                    <div class="config-icon">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>

                    <div class="config-card-content">
                        <div class="config-card-title">Perfis de acesso</div>
                        <p class="config-card-description">
                            Configure perfis e permissões dos usuários.
                        </p>
                    </div>

                    <div class="config-card-arrow">
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>

                </a>

            </div>
        </div>


        <!-- CLÍNICAS -->
        <div class="col-xl-4 col-md-6" asp-permissao="Clientes_Acessar">
            <div class="config-card">

                <a href="@Url.Action("Consulta", "Clientes")" class="config-card-link">

                    <div class="config-icon">
                        <i class="fa-solid fa-building"></i>
                    </div>

                    <div class="config-card-content">
                        <div class="config-card-title">Clínicas</div>
                        <p class="config-card-description">
                            Gerencie os dados e configurações das clínicas.
                        </p>
                    </div>

                    <div class="config-card-arrow">
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>

                </a>

            </div>
        </div>

    </div>
</div>


<div class="config-section">

    <div class="config-section-header">
        <div class="config-section-title">
            Sistema
        </div>

        <p class="config-section-description">
            Outras opções e parâmetros da aplicação.
        </p>
    </div>


    <div class="row g-3">

        <!-- EM BREVE -->
        <div class="col-xl-4 col-md-6">

            <div class="config-card config-card-disabled">

                <div class="config-badge">
                    Em breve
                </div>

                <div class="config-card-link">

                    <div class="config-icon">
                        <i class="fa-solid fa-sliders"></i>
                    </div>

                    <div class="config-card-content">
                        <div class="config-card-title">Parâmetros gerais</div>
                        <p class="config-card-description">
                            Personalizações e parâmetros gerais do sistema.
                        </p>
                    </div>

                    <div class="config-card-arrow">
                        <i class="fa-solid fa-lock"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>