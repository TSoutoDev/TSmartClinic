@using TSmartClinic.Presentation.Models
@model TSmartClinic.Presentation.Models.ResponseViewModel<PacienteViewModel>

@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewBag.Titulo = "Central do Paciente";

    var paciente = Model?.Itens?.FirstOrDefault();
}

@section Styles {
    <link rel="stylesheet" href="~/css/central-paciente.css" asp-append-version="true" />
}

<div class="central-wrapper">

    <div class="central-page-header">
        <div class="central-page-title">
            <a href="@Url.Action("Consulta", "Pacientes")" class="central-back" title="Voltar para consulta">
                <i class="fa-solid fa-arrow-left"></i>
            </a>

            <h4>Central do Paciente</h4>
        </div>

        @if (paciente != null)
        {
            <div class="central-header-actions">
                <a href="@Url.Action("Cadastro", "Pacientes", new { id = paciente.Id })" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-pen me-1"></i>Editar Paciente
                </a>

                <a href="#" class="btn central-btn-primary">
                    <i class="fa-regular fa-calendar-plus me-1"></i>Novo Agendamento
                </a>
            </div>
        }
    </div>

    <div class="central-container-card">

        <section class="central-paciente-section">
            @await Html.PartialAsync("_PacientesDados", Model)
        </section>

        <div class="central-divider"></div>

        <section class="central-acessos-section">

            <div class="acessos-header">
                <div>
                    <h5>Acessos Rápidos</h5>
                    <p>Acesse rapidamente as principais informações e rotinas do paciente.</p>
                </div>
            </div>

            <div class="row g-3">

                <div class="col-md-6 col-xl-3">
                    <a href="#" class="acesso-card">
                        <div class="acesso-icon icon-blue"><i class="fa-regular fa-calendar-check"></i></div>
                        <div class="acesso-info">
                            <strong>Agendamentos</strong>
                            <span>Consultas, retornos e próximos atendimentos.</span>
                        </div>
                        <i class="fa-solid fa-chevron-right acesso-arrow"></i>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a href="#" class="acesso-card">
                        <div class="acesso-icon icon-purple"><i class="fa-solid fa-notes-medical"></i></div>
                        <div class="acesso-info">
                            <strong>Prontuário</strong>
                            <span>Histórico clínico, evoluções e atendimentos.</span>
                        </div>
                        <i class="fa-solid fa-chevron-right acesso-arrow"></i>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a href="#" class="acesso-card">
                        <div class="acesso-icon icon-green"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                        <div class="acesso-info">
                            <strong>Orçamentos</strong>
                            <span>Planos de tratamento, valores e propostas.</span>
                        </div>
                        <i class="fa-solid fa-chevron-right acesso-arrow"></i>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a href="#" class="acesso-card">
                        <div class="acesso-icon icon-orange"><i class="fa-solid fa-wallet"></i></div>
                        <div class="acesso-info">
                            <strong>Financeiro</strong>
                            <span>Pagamentos, cobranças e situação financeira.</span>
                        </div>
                        <i class="fa-solid fa-chevron-right acesso-arrow"></i>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a href="#" class="acesso-card">
                        <div class="acesso-icon icon-cyan"><i class="fa-solid fa-flask-vial"></i></div>
                        <div class="acesso-info">
                            <strong>Exames</strong>
                            <span>Solicitações, anexos e resultados disponíveis.</span>
                        </div>
                        <i class="fa-solid fa-chevron-right acesso-arrow"></i>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a href="#" class="acesso-card">
                        <div class="acesso-icon icon-red"><i class="fa-solid fa-prescription"></i></div>
                        <div class="acesso-info">
                            <strong>Receitas</strong>
                            <span>Receitas, medicamentos e prescrições.</span>
                        </div>
                        <i class="fa-solid fa-chevron-right acesso-arrow"></i>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a href="#" class="acesso-card">
                        <div class="acesso-icon icon-blue"><i class="fa-regular fa-folder-open"></i></div>
                        <div class="acesso-info">
                            <strong>Documentos</strong>
                            <span>Arquivos, termos, anexos e documentos.</span>
                        </div>
                        <i class="fa-solid fa-chevron-right acesso-arrow"></i>
                    </a>
                </div>

                <div class="col-md-6 col-xl-3">
                    <a href="#" class="acesso-card">
                        <div class="acesso-icon icon-purple"><i class="fa-solid fa-clock-rotate-left"></i></div>
                        <div class="acesso-info">
                            <strong>Histórico</strong>
                            <span>Linha do tempo de eventos do paciente.</span>
                        </div>
                        <i class="fa-solid fa-chevron-right acesso-arrow"></i>
                    </a>
                </div>

            </div>

            <div class="resumo-card">
                <div class="resumo-grid">

                    <div class="resumo-item">
                        <span>Próxima consulta</span>
                        <strong>-</strong>
                    </div>

                    <div class="resumo-item">
                        <span>Último atendimento</span>
                        <strong>-</strong>
                    </div>

                    <div class="resumo-item">
                        <span>Total de atendimentos</span>
                        <strong>0</strong>
                    </div>

                    <div class="resumo-item">
                        <span>Pendências financeiras</span>
                        <strong>R$ 0,00</strong>
                    </div>

                </div>
            </div>

        </section>

    </div>

</div>