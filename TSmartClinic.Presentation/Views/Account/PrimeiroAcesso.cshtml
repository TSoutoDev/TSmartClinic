@{
    Layout = null;
}

@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@model TSmartClinic.Presentation.Models.ResetSenhaEPrimeiroAcessoViewModel

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="pt-br">
<style>
    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        width: 100%;
        min-height: 100%;
    }

    body {
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
        color: #102044;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 34px;
        overflow-x: hidden;
        background: radial-gradient(circle at 12% 16%, rgba(87, 76, 255, .18) 0, rgba(87, 76, 255, 0) 34%), radial-gradient(circle at 88% 78%, rgba(75, 207, 226, .13) 0, rgba(75, 207, 226, 0) 32%), linear-gradient(135deg, #f8f8ff 0%, #f4f6fb 55%, #f3fbfd 100%);
    }

    /* CARD PRINCIPAL */

    .login-card {
        width: min(1180px, 94vw);
        min-height: 620px;
        display: grid;
        grid-template-columns: 45% 55%;
        background: #fff;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 34px 95px rgba(25, 39, 85, .18);
    }

    /* PAINEL ESQUERDO */

    .brand-panel {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        color: #fff;
        padding: 58px 60px;
        background: radial-gradient(circle at 72% 86%, rgba(105, 49, 255, .46), transparent 35%), linear-gradient(150deg, #07182f 0%, #0a1b43 42%, #142866 73%, #291f8a 100%);
    }

        .brand-panel::after {
            content: '';
            position: absolute;
            inset: auto -140px -230px -210px;
            height: 500px;
            z-index: -1;
            border-radius: 50% 50% 0 0;
            border-top: 2px solid rgba(122, 67, 255, .8);
            background: radial-gradient(ellipse at 66% 18%, rgba(82, 77, 255, .26), transparent 55%), linear-gradient(180deg, rgba(79, 52, 204, .20), rgba(16, 28, 78, .08));
            transform: rotate(-2deg);
        }

    .brand-logo {
        position: relative;
        z-index: 3;
        display: block;
        width: min(360px, 90%);
        height: auto;
    }

    .brand-copy {
        position: relative;
        z-index: 3;
        margin-top: 90px;
        max-width: 360px;
    }

    .brand-accent {
        width: 58px;
        height: 4px;
        border-radius: 999px;
        margin-bottom: 26px;
        background: linear-gradient(90deg, #a443f3, #2876ff);
        box-shadow: 0 0 14px rgba(96, 78, 255, .42);
    }

    .brand-copy h1 {
        margin: 0;
        font-size: 40px;
        line-height: 1.2;
        font-weight: 600;
        letter-spacing: -1.4px;
        color: #fff;
    }

    .brand-copy p {
        margin: 22px 0 0;
        font-size: 17px;
        line-height: 1.6;
        color: rgba(230, 235, 255, .86);
    }

    /* PAINEL DIREITO */

    .form-panel {
        position: relative;
        display: flex;
        align-items: center;
        padding: 64px 78px;
        background: #fff;
    }

    .form-wrap {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
    }

    /* ÁREA SEGURA */

    .secure-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 14px;
        border-radius: 14px;
        margin-bottom: 24px;
        font-size: 14px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: .3px;
        color: #2858ee;
        background: #edf0ff;
    }

        .secure-badge i {
            color: #2858ee;
        }

    /* TÍTULO */

    .form-title {
        margin: 0;
        font-size: 40px;
        line-height: 1.1;
        font-weight: 750;
        letter-spacing: -1.5px;
        color: #102044;
    }

    .form-subtitle {
        margin: 15px 0 38px;
        font-size: 16px;
        line-height: 1.6;
        color: #7d89a8;
    }

    /* CAMPOS */

    .field-group {
        width: 100%;
        margin-bottom: 24px;
    }

    .field-label {
        display: block;
        margin-bottom: 10px;
        color: #132344;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 700;
    }

    .input-wrap {
        position: relative;
        width: 100%;
    }

    .field-icon {
        position: absolute;
        z-index: 2;
        left: 21px;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        text-align: center;
        color: #9aa5bf;
        font-size: 17px;
        pointer-events: none;
    }

    .form-panel .form-control {
        display: block;
        width: 100% !important;
        height: 64px !important;
        min-height: 64px !important;
        padding: 0 20px 0 58px !important;
        border: 1px solid #dfe4ef !important;
        border-radius: 15px !important;
        outline: none !important;
        background: #fbfcff !important;
        color: #1c2947 !important;
        font-family: 'Inter', sans-serif !important;
        font-size: 15px !important;
        font-weight: 400 !important;
        line-height: 64px !important;
        box-shadow: inset 0 1px 1px rgba(17, 32, 68, .02) !important;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .form-panel .form-control::placeholder {
            color: #a5aec3 !important;
            opacity: 1;
        }

        .form-panel .form-control:hover {
            border-color: #cbd3e2 !important;
        }

        .form-panel .form-control:focus {
            background: #fff !important;
            border-color: #7280f7 !important;
            box-shadow: 0 0 0 4px rgba(76, 91, 244, .09) !important;
        }

    /* MENSAGENS DE VALIDAÇÃO */

    .text-danger {
        display: block;
        margin-top: 7px;
        color: #d94254;
        font-size: 12px;
        line-height: 1.4;
    }

    /* BOTÃO */

    .btn-login {
        width: 100%;
        height: 64px;
        margin-top: 4px;
        border: 0;
        border-radius: 16px;
        color: #fff;
        background: linear-gradient(100deg, #7b31ef 0%, #5150f1 48%, #156cf8 100%);
        font-family: 'Inter', sans-serif;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -.2px;
        cursor: pointer;
        box-shadow: 0 15px 30px rgba(74, 73, 235, .22);
        transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
    }

        .btn-login i {
            margin-left: 12px;
        }

        .btn-login:hover {
            transform: translateY(-1px);
            filter: brightness(1.03);
            box-shadow: 0 19px 34px rgba(74, 73, 235, .27);
        }

        .btn-login:active {
            transform: translateY(0);
        }

    /* ALERTAS */

    .alert {
        position: relative;
        margin-top: 18px;
        padding: 13px 15px;
        border-radius: 12px;
        font-size: 13px;
        line-height: 1.5;
    }

    .alert-success {
        color: #1e6848;
        background: #ebfaf2;
        border: 1px solid #caedd9;
    }

    .alert-danger {
        color: #9e2c3a;
        background: #fff1f3;
        border: 1px solid #f3cbd2;
    }

    /* LOADING */

    #loading {
        position: fixed;
        z-index: 9999;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(248, 249, 253, .72);
        backdrop-filter: blur(3px);
    }

        #loading img {
            width: 70px;
            height: 70px;
        }

    /* RESPONSIVO */

    @@media (max-width: 1100px) {

        .login-card {
            grid-template-columns: 43% 57%;
        }

        .brand-panel {
            padding: 52px 42px;
        }

        .brand-copy {
            margin-top: 70px;
        }

            .brand-copy h1 {
                font-size: 34px;
            }

            .brand-copy p {
                font-size: 16px;
            }

        .form-panel {
            padding: 52px 48px;
        }

        .form-title {
            font-size: 38px;
        }
    }

    @@media (max-width: 820px) {

        body {
            padding: 18px;
            align-items: flex-start;
        }

        .login-card {
            width: min(610px, 100%);
            min-height: auto;
            grid-template-columns: 1fr;
            border-radius: 24px;
        }

        .brand-panel {
            min-height: 280px;
            padding: 38px 34px;
        }

        .brand-logo {
            width: 290px;
        }

        .brand-copy {
            margin-top: 40px;
            max-width: 360px;
        }

            .brand-copy h1 {
                font-size: 31px;
            }

            .brand-copy p {
                font-size: 15px;
            }

        .form-panel {
            padding: 44px 34px;
        }

        .form-title {
            font-size: 36px;
        }
    }

    @@media (max-width: 480px) {

        body {
            padding: 0;
            background: #fff;
        }

        .login-card {
            width: 100%;
            min-height: 100vh;
            border-radius: 0;
            box-shadow: none;
        }

        .brand-panel {
            min-height: 240px;
            padding: 28px 24px;
        }

        .brand-logo {
            width: 235px;
        }

        .brand-copy {
            margin-top: 30px;
        }

        .brand-accent {
            margin-bottom: 17px;
        }

        .brand-copy h1 {
            font-size: 26px;
        }

        .brand-copy p {
            margin-top: 15px;
            font-size: 14px;
        }

        .form-panel {
            padding: 36px 24px;
            align-items: flex-start;
        }

        .secure-badge {
            margin-bottom: 20px;
        }

        .form-title {
            font-size: 32px;
        }

        .form-subtitle {
            margin: 13px 0 30px;
            font-size: 15px;
        }

        .form-panel .form-control {
            height: 58px !important;
            min-height: 58px !important;
            line-height: 58px !important;
        }

        .btn-login {
            height: 60px;
            font-size: 16px;
        }
    }
</style>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TSmartClinic - Primeiro Acesso</title>

    <link href="~/main.css" rel="stylesheet" />
    <link href="~/home.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <style>
        /* USE EXATAMENTE O MESMO CSS DA VIEW EsqueciSenha */
    </style>
</head>

<body>
    @Html.AntiForgeryToken()

    <div id="loading" style="display:none;">
        <img src="~/images/loading.TSmartClinic.gif" alt="Carregando..." width="70" height="70" />
    </div>

    <main class="login-card">

        <section class="brand-panel">
            <img src="~/images/branding/tsmartclinic-logo-on-dark.svg" class="brand-logo" alt="TSmartClinic" />

            <div class="brand-copy">
                <div class="brand-accent"></div>
                <h1>Seu primeiro acesso começa aqui.</h1>
                <p>Defina uma senha segura para começar a utilizar o TSmartClinic.</p>
            </div>
        </section>

        <section class="form-panel">
            <div class="form-wrap">

                <div class="secure-badge">
                    <i class="fas fa-lock"></i>
                    ÁREA SEGURA
                </div>

                <h2 class="form-title">Definir senha</h2>
                <p class="form-subtitle">Crie sua nova senha para acessar o sistema.</p>

                @using (Html.BeginForm("PrimeiroAcesso", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Token)
                    @Html.HiddenFor(m => m.Email)

                    <div class="field-group">
                        <label class="field-label" for="NovaSenha">Nova senha</label>

                        <div class="input-wrap">
                            <i class="fas fa-lock field-icon"></i>
                            @Html.PasswordFor(m => m.NovaSenha, new
                            {
                                @class = "form-control",
                                                placeholder = "Digite sua nova senha",
                                                autocomplete = "off"
                                                })
                    </div>

                    <span class="text-danger">@Html.ValidationMessageFor(m => m.NovaSenha)</span>
                </div>

                <div class="field-group">
                    <label class="field-label" for="ConfirmarSenha">Confirmar senha</label>

                    <div class="input-wrap">
                        <i class="fas fa-lock field-icon"></i>
                        @Html.PasswordFor(m => m.ConfirmarSenha, new
                                                {
                                @class = "form-control",
                                                placeholder = "Confirme sua nova senha",
                                                autocomplete = "off"
                                                })
                    </div>

                    <span class="text-danger">@Html.ValidationMessageFor(m => m.ConfirmarSenha)</span>
                </div>

                <button type="submit" class="btn-login" onclick="loading()">
                    Salvar senha <i class="fas fa-arrow-right"></i>
                </button>

                @if (TempData["MensagemSucesso"] != null)
                    {
                        <div class="alert alert-success">
                            @Html.Raw(TempData["MensagemSucesso"])
                        </div>
                    }
                    else if (TempData["MensagemErro"] != null)
                    {
                        <div class="alert alert-danger">
                            @Html.Raw(TempData["MensagemErro"])
                        </div>
                    }
                }

            </div>
        </section>

    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/scripts/main.js"></script>

    <script>
        function loading() {
            $('#loading').css('display', 'flex');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const params = new URLSearchParams(window.location.search);
            const token = params.get('token');

            if (token) {
                const input = document.querySelector('input[name="Token"]');

                if (input) {
                    input.value = token;
                }

                const url = new URL(window.location.href);
                url.searchParams.delete('token');

                window.history.replaceState({}, "", url.pathname);
            }
        });
    </script>
</body>
</html>