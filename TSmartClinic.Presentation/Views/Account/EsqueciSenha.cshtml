@{
    Layout = null;
}

@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@model TSmartClinic.Presentation.Models.EsqueciSenhaViewModel

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TSmartClinic - Recuperar Senha</title>

    <link href="~/main.css" rel="stylesheet" />
    <link href="~/home.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            color: #102044;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 34px;
            background: radial-gradient(circle at 12% 16%, rgba(87, 76, 255, .18) 0, rgba(87, 76, 255, 0) 34%), radial-gradient(circle at 88% 78%, rgba(75, 207, 226, .13) 0, rgba(75, 207, 226, 0) 32%), linear-gradient(135deg, #f8f8ff 0%, #f4f6fb 55%, #f3fbfd 100%);
        }

        .login-card {
            width: min(1180px, 94vw);
            min-height: 620px;
            display: grid;
            grid-template-columns: 45% 55%;
            background: #fff;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 34px 95px rgba(25, 39, 85, .18);
        }

        .brand-panel {
            position: relative;
            overflow: hidden;
            color: #fff;
            padding: 58px 60px;
            background: radial-gradient(circle at 72% 86%, rgba(105, 49, 255, .46), transparent 35%), linear-gradient(150deg, #07182f 0%, #0a1b43 42%, #142866 73%, #291f8a 100%);
        }

        .brand-logo {
            width: min(360px, 90%);
            height: auto;
        }

        .brand-copy {
            margin-top: 90px;
            max-width: 360px;
        }

        .brand-accent {
            width: 58px;
            height: 4px;
            border-radius: 999px;
            margin-bottom: 26px;
            background: linear-gradient(90deg, #a443f3, #2876ff);
        }

        .brand-copy h1 {
            margin: 0;
            font-size: 40px;
            line-height: 1.2;
            font-weight: 600;
            letter-spacing: -1.4px;
        }

        .brand-copy p {
            margin-top: 22px;
            font-size: 17px;
            line-height: 1.6;
            color: rgba(230, 235, 255, .86);
        }

        .form-panel {
            display: flex;
            align-items: center;
            padding: 64px 78px;
            background: #fff;
        }

        .form-wrap {
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
        }

        .secure-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 10px 14px;
            border-radius: 14px;
            margin-bottom: 24px;
            font-size: 14px;
            font-weight: 800;
            color: #2858ee;
            background: #edf0ff;
        }

        .form-title {
            margin: 0;
            font-size: 40px;
            line-height: 1.1;
            font-weight: 750;
            letter-spacing: -1.5px;
        }

        .form-subtitle {
            margin: 15px 0 38px;
            font-size: 16px;
            line-height: 1.6;
            color: #7d89a8;
        }

        .field-group {
            margin-bottom: 24px;
        }

        .field-label {
            display: block;
            margin-bottom: 9px;
            font-size: 14px;
            font-weight: 700;
            color: #132344;
        }

        .input-wrap {
            position: relative;
        }

        .field-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #9aa5bf;
            font-size: 17px;
        }

        .form-control {
            width: 100%;
            height: 64px;
            padding: 0 20px 0 58px;
            border: 1px solid #dfe4ef;
            border-radius: 15px;
            background: #fbfcff;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            color: #1c2947;
            outline: none;
        }

            .form-control:focus {
                background: #fff;
                border-color: #7280f7;
                box-shadow: 0 0 0 4px rgba(76, 91, 244, .09);
            }

        .btn-login {
            width: 100%;
            height: 64px;
            border: 0;
            border-radius: 16px;
            color: #fff;
            background: linear-gradient(100deg, #7b31ef 0%, #5150f1 48%, #156cf8 100%);
            font-size: 17px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 15px 30px rgba(74, 73, 235, .22);
        }

        .back-login {
            display: block;
            text-align: center;
            margin-top: 22px;
            color: #1158f6;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
        }

        .text-danger {
            display: block;
            margin-top: 7px;
            font-size: 12px;
        }

        .alert {
            margin-top: 18px;
            padding: 13px 15px;
            border-radius: 12px;
            font-size: 13px;
        }

        @@media (max-width: 820px) {
            body {
                padding: 18px;
                align-items: flex-start;
            }

            .login-card {
                grid-template-columns: 1fr;
                min-height: auto;
            }

            .brand-panel {
                min-height: 280px;
                padding: 38px 34px;
            }

            .brand-copy {
                margin-top: 40px;
            }

            .form-panel {
                padding: 44px 34px;
            }
        }
    </style>
</head>

<body>
    @Html.AntiForgeryToken()

    <main class="login-card">

        <section class="brand-panel">
            <img src="~/images/branding/tsmartclinic-logo-on-dark.svg" class="brand-logo" alt="TSmartClinic" />

            <div class="brand-copy">
                <div class="brand-accent"></div>
                <h1>Recupere seu acesso com segurança.</h1>
                <p>Informe seu e-mail e enviaremos as instruções para redefinir sua senha.</p>
            </div>
        </section>

        <section class="form-panel">
            <div class="form-wrap">

                <div class="secure-badge">
                    <i class="fas fa-lock"></i>
                    ÁREA SEGURA
                </div>

                <h2 class="form-title">Recuperar senha</h2>
                <p class="form-subtitle">Digite o e-mail cadastrado na sua conta.</p>

                @using (Html.BeginForm("EsqueciSenha", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="field-group">
                        <label class="field-label" for="Email">E-mail</label>

                        <div class="input-wrap">
                            <i class="far fa-envelope field-icon"></i>
                            @Html.TextBoxFor(m => m.Email, new
                            {
                                @class = "form-control",
                                                placeholder = "Digite seu e-mail",
                                                autocomplete = "off"
                                                })
                    </div>

                    <span class="text-danger">@Html.ValidationMessageFor(m => m.Email)</span>
                </div>

                <button type="submit" class="btn-login">
                    Enviar link de redefinição <i class="fas fa-arrow-right"></i>
                </button>

                <a href="~/account/login" class="back-login">
                    <i class="fas fa-arrow-left"></i>&nbsp; Voltar ao login
                </a>

                @if (TempData["MensagemSucesso"] != null)
                    {
                        <div class="alert alert-success">
                            @Html.Raw(TempData["MensagemSucesso"])
                        </div>
                    }
                    else if (TempData["MensagemErro"] != null)
                    {
                        <div class="alert alert-danger">
                            @Html.Raw(TempData["MensagemErro"])
                        </div>
                    }
                }

            </div>
        </section>

    </main>
</body>
</html>