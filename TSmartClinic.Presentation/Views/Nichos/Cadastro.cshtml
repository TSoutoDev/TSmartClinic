@model TSmartClinic.Presentation.Models.NichoViewModel
@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewBag.Titulo = "Cadastro de Nichos";
}

@using (Html.BeginForm("Cadastro", "Nichos", FormMethod.Post))
{
    @Html.HiddenFor(model => model.PublicId)

    <div class="row">
        <div class="col-md-12">
            <div class="card card-small">
                <div class="card-body">

                    <div class="row">
                        <div class="col-md-5">
                            <label>Nome</label>
                            @Html.TextBoxFor(model => model.NomeNicho, new { @class = "form-control", @autocomplete = "off" })
                            <span class="text-danger">
                                @Html.ValidationMessageFor(model => model.NomeNicho)
                            </span>
                        </div>
                    </div>

                </div>

                <div class="card-body">
                    <div class="mt-1 row">
                        <div class="col-md-2">
                            <label>Situação</label>

                            @if (!Model.PublicId.HasValue || Model.PublicId.Value == Guid.Empty)
                            {
                                <input type="hidden" name="Ativo" value="true" />

                                <select class="form-select" disabled>
                                    <option value="true" selected>Ativo</option>
                                </select>
                            }
                            else
                            {
                                <select asp-for="Ativo" class="form-select">
                                    <option value="true">Ativo</option>
                                    <option value="false">Inativo</option>
                                </select>
                            }
                        </div>
                    </div>


                    <div class="mt-3 d-flex gap-2">
                        <button type="submit"
                                class="btn btn-success"
                                asp-permissao="@(Model.PublicId.HasValue && Model.PublicId.Value != Guid.Empty ? "Nichos_Editar" : "Nichos_Incluir")"
                                onclick="loading()">Gravar
                        </button>

                        @if (Model.PublicId.HasValue && Model.PublicId.Value != Guid.Empty)
                        {
                            <button type="submit"
                                    class="btn btn-danger"
                                    asp-permissao="Nichos_Excluir"
                                    formaction="@Url.Action("Excluir", "Nichos")"
                                    formmethod="post"
                                    onclick="loading()">Excluir
                            </button>
                        }

                        <a href="/Nichos/Consulta" class="btn btn-secondary">Voltar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>




}

